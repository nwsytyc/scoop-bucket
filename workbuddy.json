    },
    "installer": {
        "script": [
            "7z e \"$dir\\$fname\" -o\"$dir\\_nsis_temp\" -tnsis -y | Out-Null",
            "7z x \"$dir\\_nsis_temp\\app-64.7z\" -o\"$dir\" -y | Out-Null",
            "Remove-Item \"$dir\\_nsis_temp\" -Recurse -Force",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "post_install": [
        "if (!(Test-Path \"$dir\\data\\extensions\") -and (Test-Path \"$env:USERPROFILE\\.workbuddy\\extensions\")) {",
        "    info '[Portable Mode] Copying extensions...'",
        "    Copy-Item \"$env:USERPROFILE\\.workbuddy\\extensions\" \"$dir\\data\" -Recurse",
        "}",
        "if (!(Test-Path \"$dir\\data\\user-data\") -and (Test-Path \"$env:AppData\\WorkBuddy\")) {",
        "    info '[Portable Mode] Copying user data...'",
        "    Copy-Item \"$env:AppData\\WorkBuddy\" \"$dir\\data\\user-data\" -Recurse",
        "}"
    ],
    "bin": [
        [
            "WorkBuddy.exe",
            "workbuddy"
        ]
    ],
    "shortcuts": [
        [
            "WorkBuddy.exe",
            "WorkBuddy"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://www.codebuddy.cn/v2/update?platform=workbuddy-win32-x64-user",
        "jsonpath": "$.url",
        "regex": "(?<url>.*WorkBuddy-win32-x64-user-(?<version>[\\d.]+-\\d+-[\\w.]+)\\.exe)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.codebuddy.cn/workbuddy/saas/win32-x64-user/WorkBuddy-win32-x64-user-$version.exe"
            }
        }
    }
